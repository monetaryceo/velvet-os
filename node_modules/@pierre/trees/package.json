{
  "name": "@pierre/trees",
  "version": "0.0.1-beta.4",
  "license": "apache-2.0",
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/components/web-components.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components.d.ts",
      "import": "./dist/web-components.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --clean",
    "dev": "echo 'Watching for changes…' && tsdown --watch --log-level error",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "test:e2e": "bun run build && (bun ./test/e2e/check-playwright-binary.ts || bun run test:e2e:installbinary) && bunx playwright test -c test/e2e/playwright.config.ts",
    "test:e2e:installbinary": "bunx playwright@1.51.1 install chromium",
    "test:e2e:server": "vite --config test/e2e/vite.config.ts",
    "tsc": "tsgo --noEmit --pretty",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@headless-tree/core": "1.6.1",
    "preact": "11.0.0-beta.0",
    "preact-render-to-string": "6.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.2",
    "@playwright/test": "1.51.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsdown": "0.15.11",
    "typescript": "5.9.2",
    "vite": "npm:rolldown-vite@7.1.12"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
